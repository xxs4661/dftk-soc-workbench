&CONTROL
 calculation='scf', prefix='si', restart_mode='from_scratch',
 pseudo_dir='../pseudo', outdir='./scratch', verbosity='high',
/
&SYSTEM
 ibrav=0, nat=2, ntyp=1, nbnd=8,
 ecutwfc=60, ecutrho=240,
 nspin=1, noncolin=.false., lspinorb=.false.,
 nosym=.true., noinv=.true., occupations='fixed',
/
&ELECTRONS
 conv_thr=1e-10, electron_maxstep=150,
 diago_full_acc=.true.,
/
ATOMIC_SPECIES
 Si 28.0855 Si.upf
CELL_PARAMETERS bohr
0 5.13 5.13
5.13 0 5.13
5.13 5.13 0
ATOMIC_POSITIONS crystal
Si 0 0 0
Si 0.25 0.25 0.25
K_POINTS crystal
8
0 0 0 0.125
0 0 -0.5 0.125
0 -0.5 0 0.125
0 -0.5 -0.5 0.125
-0.5 0 0 0.125
-0.5 0 -0.5 0.125
-0.5 -0.5 0 0.125
-0.5 -0.5 -0.5 0.125
